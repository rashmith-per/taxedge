{
  "expo": {
    "name": "Finsolz",
    "slug": "finsolz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "finsolzmobile",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/903596d2-48e5-4d35-ae72-3f34cba67b4a",
      "checkAutomatically": "NEVER",
      "enabled": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.finsolz.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Finsolz uses Face ID to securely authenticate and access your account."
      }
    },
    "android": {
      "package": "com.finsolz.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1D36",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Finsolz uses your photos so you can set a profile picture.",
          "cameraPermission": "Finsolz uses your camera so you can take a profile picture."
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Finsolz uses your location to fill the GST business address."
        }
      ],
      "./plugins/withUcropDone",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#0066CC"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Finsolz uses Face ID to securely authenticate and access your account."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "903596d2-48e5-4d35-ae72-3f34cba67b4a"
      }
    },
    "owner": "shashiprakash833"
  }
}
